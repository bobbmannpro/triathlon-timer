{
  "rules": {
    "watchTokens": {
      "$token": {
        ".read": true,
        ".write": "auth != null && (!data.exists() ? newData.child('createdBy').val() === auth.uid : (data.child('createdBy').val() === auth.uid || !data.child('createdBy').exists() || root.child('liveRaces').child(data.child('raceCode').val() + '').child('publishedBy').val() === auth.uid))",
        "race": {
          ".write": "auth != null && (root.child('watchTokens').child($token).child('createdBy').val() === auth.uid || root.child('liveRaces').child(root.child('watchTokens').child($token).child('raceCode').val() + '').child('publishedBy').val() === auth.uid)"
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "liveRaces": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (((!data.exists() || !data.child('publishedBy').exists()) && ((auth.uid === 'nfH10ASvHbZkazkXMkEIoo8IbGY2' || auth.uid === 'yomrf3PDWoRGMsAZJudT7Y4LuYE3') || auth.uid === 'zaZlSgcfROeSKUwgFz2Qwsu0WVg2' || (root.child('hostAccess').child(auth.uid).exists() && (!root.child('hostAccess').child(auth.uid).child('until').exists() || root.child('hostAccess').child(auth.uid).child('until').val() > now)))) || data.child('publishedBy').val() === auth.uid)",
        "waypoints": {
          ".read": "root.child('liveRaces').child($code).child('status').val() === 'live'"
        },
        "clockMs": {
          ".read": "root.child('liveRaces').child($code).child('status').val() === 'live'"
        },
        "registrations": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (root.child('liveRaces').child($code).child('status').val() === 'registration' || root.child('liveRaces').child($code).child('status').val() === 'live')",
            ".validate": "newData.child('uid').val() === $uid"
          }
        },
        "athletes": {
          "$idx": {
            "gps": {
              ".write": "root.child('liveRaces').child($code).child('status').val() === 'live'"
            },
            "splits": {
              "$seg": {
                ".write": "auth != null && root.child('liveRaces').child($code).child('status').val() === 'live'"
              }
            },
            "startOffset": {
              ".write": "auth != null && root.child('liveRaces').child($code).child('status').val() === 'live'"
            },
            "started": {
              ".write": "auth != null && root.child('liveRaces').child($code).child('status').val() === 'live'"
            },
            "finished": {
              ".write": "auth != null && root.child('liveRaces').child($code).child('status').val() === 'live'"
            },
            "trainer": {
              ".write": "auth != null && root.child('liveRaces').child($code).child('status').val() === 'live'"
            },
            "hr": {
              ".write": "auth != null && root.child('liveRaces').child($code).child('status').val() === 'live'"
            }
          }
        }
      }
    },
    "raceDirectory": {
      ".read": true,
      "$code": {
        ".write": "auth != null && (data.exists() ? data.child('hostUid').val() === auth.uid : (newData.child('hostUid').val() === auth.uid && ((auth.uid === 'nfH10ASvHbZkazkXMkEIoo8IbGY2' || auth.uid === 'yomrf3PDWoRGMsAZJudT7Y4LuYE3') || auth.uid === 'zaZlSgcfROeSKUwgFz2Qwsu0WVg2' || (root.child('hostAccess').child(auth.uid).exists() && (!root.child('hostAccess').child(auth.uid).child('until').exists() || root.child('hostAccess').child(auth.uid).child('until').val() > now)))))",
        ".validate": "!newData.exists() || (newData.child('hostUid').val() === auth.uid && newData.hasChildren(['kind', 'name', 'status']))"
      }
    },
    "raceContacts": {
      "$code": {
        ".read": "auth != null && root.child('liveRaces').child($code).child('publishedBy').val() === auth.uid",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['email']) && newData.child('email').isString()"
        }
      }
    },
    "swimLive": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() ? (newData.child('hostUid').val() === auth.uid && ((auth.uid === 'nfH10ASvHbZkazkXMkEIoo8IbGY2' || auth.uid === 'yomrf3PDWoRGMsAZJudT7Y4LuYE3') || auth.uid === 'zaZlSgcfROeSKUwgFz2Qwsu0WVg2' || (root.child('hostAccess').child(auth.uid).exists() && (!root.child('hostAccess').child(auth.uid).child('until').exists() || root.child('hostAccess').child(auth.uid).child('until').val() > now)))) : data.child('hostUid').val() === auth.uid)",
        "results": {
          "$lane": {
            ".write": "auth != null && root.child('swimLive').child($code).exists()"
          }
        },
        "timers": {
          "$lane": {
            ".write": "auth != null && root.child('swimLive').child($code).exists()"
          }
        },
        "clock": {
          "$k": {
            ".write": "auth != null && root.child('swimLive').child($code).exists()"
          }
        }
      }
    },
    "photoAlbums": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (data.exists() ? data.child('ownerUid').val() === auth.uid : newData.child('ownerUid').val() === auth.uid)",
        ".validate": "!newData.exists() || (newData.child('ownerUid').val() === auth.uid && newData.hasChildren(['name']))"
      }
    },
    "bikeFeeds": {
      "$code": {
        ".read": true,
        ".write": "auth != null && data.exists() && data.child('meta/createdBy').val() === auth.uid",
        "meta": {
          ".write": "auth != null && (!data.exists() || data.child('createdBy').val() === auth.uid)",
          ".validate": "newData.hasChildren(['riderName', 'createdBy']) && newData.child('createdBy').val() === auth.uid"
        },
        "status": {
          ".write": "auth != null",
          ".validate": "newData.isString()"
        },
        "startedAt": {
          ".write": "auth != null",
          ".validate": "!newData.exists() || newData.isNumber()"
        },
        "finishedAt": {
          ".write": "auth != null",
          ".validate": "!newData.exists() || newData.isNumber()"
        },
        "live": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['lat', 'lng', 't'])",
          "lat": {
            ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
          },
          "lng": {
            ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
          },
          "t": {
            ".validate": "newData.isNumber()"
          },
          "$field": {
            ".validate": true
          }
        },
        "progress": {
          ".write": "auth != null",
          "distM": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "elapsedMs": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "day": {
            ".validate": "newData.isNumber() && newData.val() >= 1"
          },
          "$field": {
            ".validate": true
          }
        },
        "track": {
          ".write": "auth != null",
          "$crumb": {
            ".validate": "newData.hasChildren(['0', '1'])"
          }
        }
      }
    },
    "hostAccess": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (auth.uid === 'nfH10ASvHbZkazkXMkEIoo8IbGY2' || auth.uid === 'yomrf3PDWoRGMsAZJudT7Y4LuYE3'))",
        ".write": "auth != null && ((auth.uid === 'nfH10ASvHbZkazkXMkEIoo8IbGY2' || auth.uid === 'yomrf3PDWoRGMsAZJudT7Y4LuYE3') || (auth.uid === $uid && newData.child('via').val() === 'promo' && root.child('promoCodes').child(newData.child('code').val() + '').exists() && (!data.exists() || (data.child('until').exists() && data.child('until').val() < now)) && (root.child('promoCodes').child(newData.child('code').val() + '').child('days').exists() ? (newData.child('until').isNumber() && newData.child('until').val() <= now + root.child('promoCodes').child(newData.child('code').val() + '').child('days').val() * 86400000 + 300000) : !newData.child('until').exists())))"
      }
    },
    "promoCodes": {
      ".read": "auth != null && (auth.uid === 'nfH10ASvHbZkazkXMkEIoo8IbGY2' || auth.uid === 'yomrf3PDWoRGMsAZJudT7Y4LuYE3')",
      "$code": {
        ".write": "auth != null && (auth.uid === 'nfH10ASvHbZkazkXMkEIoo8IbGY2' || auth.uid === 'yomrf3PDWoRGMsAZJudT7Y4LuYE3')",
        "redeemed": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('hostAccess').child($uid).child('code').val() === $code"
          }
        },
        ".read": "auth != null"
      }
    },
    "hostPending": {
      ".read": "auth != null && (auth.uid === 'nfH10ASvHbZkazkXMkEIoo8IbGY2' || auth.uid === 'yomrf3PDWoRGMsAZJudT7Y4LuYE3')",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || (auth.uid === 'nfH10ASvHbZkazkXMkEIoo8IbGY2' || auth.uid === 'yomrf3PDWoRGMsAZJudT7Y4LuYE3'))"
      }
    },
    "crashReports": {
      ".read": "auth != null && (auth.uid === 'nfH10ASvHbZkazkXMkEIoo8IbGY2' || auth.uid === 'yomrf3PDWoRGMsAZJudT7Y4LuYE3')",
      "$id": {
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.hasChildren(['at','msg'])"
      }
    },
    "timedRaces": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() ? (newData.child('hostUid').val() === auth.uid && ((auth.uid === 'nfH10ASvHbZkazkXMkEIoo8IbGY2' || auth.uid === 'yomrf3PDWoRGMsAZJudT7Y4LuYE3') || auth.uid === 'zaZlSgcfROeSKUwgFz2Qwsu0WVg2' || (root.child('hostAccess').child(auth.uid).exists() && (!root.child('hostAccess').child(auth.uid).child('until').exists() || root.child('hostAccess').child(auth.uid).child('until').val() > now)))) : data.child('hostUid').val() === auth.uid)",
        "athletes": {
          "$id": {
            ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid && (root.child('timedRaces').child($code).child('status').val() === 'live' || root.child('timedRaces').child($code).child('status').val() === 'signup')",
            ".validate": "!newData.exists() || newData.child('name').isString()",
            "uid": {
              ".write": "auth != null && (root.child('timedRaces').child($code).child('status').val() === 'live' || root.child('timedRaces').child($code).child('status').val() === 'signup') && !data.exists() && newData.val() === auth.uid"
            },
            "dist": {
              "$leg": {
                ".write": "auth != null && (root.child('timedRaces').child($code).child('status').val() === 'live' || (root.child('timedRaces').child($code).child('status').val() === 'signup' && root.child('timedRaces').child($code).child('liveAt').isNumber() && now >= root.child('timedRaces').child($code).child('liveAt').val())) && root.child('timedRaces').child($code).child('athletes').child($id).child('uid').val() === auth.uid",
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 200000"
              }
            }
          }
        }
      }
    }
  }
}